# Docker Compose 环境变量配置
# 复制此文件为 .env 并修改相应的密码

# PostgreSQL 数据库配置
POSTGRES_USER=pptmaster
POSTGRES_PASSWORD=pptmaster_password
POSTGRES_DB=pptmaster

# MinIO 对象存储配置
# 注意：MINIO_ROOT_USER/PASSWORD 必须与 MINIO_ACCESS_KEY/SECRET_KEY 保持一致
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 应用密钥（生产环境必须修改）
SECRET_KEY=your-secret-key-here-change-in-production

# LLM 配置（推荐使用讯飞星火大模型）
LLM_PROVIDER=openai_compatible

# 讯飞星火大模型配置
# API Key 格式：AppID:APISecret
# 示例：96ce545849f922aada14f28f8573dffd:YzM5OWQzMmYzMzE0NDllNWMwYTgxY2Q3
OPENAI_COMPATIBLE_API_KEY=your-xunfei-api-key
OPENAI_COMPATIBLE_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
OPENAI_COMPATIBLE_MODEL=astron-code-latest

# 或使用 OpenAI（可选）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview

# 或使用 Anthropic Claude（可选）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# 图片生成配置（可选）
IMAGE_GEN_PROVIDER=openai
STABILITY_API_KEY=
DALLE_MODEL=dall-e-3

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:8000/api
