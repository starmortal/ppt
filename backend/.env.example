# Application
APP_NAME=PPT Master Web
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_USER=pptmaster
POSTGRES_PASSWORD=pptmaster_password
POSTGRES_DB=pptmaster
DATABASE_URL=postgresql://pptmaster:pptmaster_password@localhost:5432/pptmaster
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pptmaster
MINIO_SECURE=False

# LLM Configuration
LLM_PROVIDER=openai_compatible  # openai, anthropic, openai_compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_BASE_URL=

# OpenAI Compatible API (讯飞星火等)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Image Generation
IMAGE_GEN_PROVIDER=openai  # openai, stability, local
STABILITY_API_KEY=sk-your-stability-key
DALLE_MODEL=dall-e-3

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Upload
MAX_UPLOAD_SIZE=100  # MB
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,pptx,ppt,md,txt

# Session
SESSION_EXPIRE_HOURS=24
MAX_SESSIONS_PER_USER=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Project Storage (容器内路径，通常不需要修改)
PROJECTS_BASE_PATH=/app/projects
SCRIPTS_BASE_PATH=/app/skills/ppt-master/scripts
